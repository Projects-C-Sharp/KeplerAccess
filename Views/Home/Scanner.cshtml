@{
    ViewData["Title"] = "Escáner QR";
    Layout = "_Layout";
}

<div class="scanner-app" id="app">

    <!-- Header -->
    <header class="app-header">
        <div class="header-left">
            <div class="logo-sm">
                <svg width="28" height="28" viewBox="0 0 40 40" fill="none">
                    <rect width="40" height="40" rx="8" fill="#FD7B41"/>
                    <path d="M20 8L32 14V26L20 32L8 26V14L20 8Z" stroke="white" stroke-width="2" fill="none"/>
                    <circle cx="20" cy="20" r="3" fill="white"/>
                </svg>
            </div>
            <div class="header-info">
                <span class="app-name">KEPLER ACCESS</span>
                <span class="employee-name" id="employeeName">Cargando...</span>
            </div>
        </div>
        <div class="header-right">
            <div class="conn-status" id="connStatus">
                <span class="conn-dot"></span>
                <span class="conn-label">EN LÍNEA</span>
            </div>
            <form method="post" action="/Home/Logout" style="display:inline" id="logoutForm">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-logout" title="Cerrar sesión">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                        <polyline points="16 17 21 12 16 7"/>
                        <line x1="21" y1="12" x2="9" y2="12"/>
                    </svg>
                </button>
            </form>
        </div>
    </header>

    <!-- Stats Bar -->
    <div class="stats-bar" id="statsBar">
        <div class="stat-item">
            <span class="stat-num" id="statTotal">—</span>
            <span class="stat-lbl">ESCANEADOS</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
            <span class="stat-num valid" id="statValid">—</span>
            <span class="stat-lbl">VÁLIDOS</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
            <span class="stat-num danger" id="statRejected">—</span>
            <span class="stat-lbl">RECHAZADOS</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
            <span class="stat-num" id="statCapacity">—%</span>
            <span class="stat-lbl">OCUPACIÓN</span>
        </div>
    </div>

    <!-- Scanner Area -->
    <div class="scanner-section">
        <div class="scanner-container" id="scannerContainer">

            <!-- Camera View -->
            <div class="camera-viewport" id="cameraViewport">
                <video id="scannerVideo" playsinline autoplay muted></video>
                <canvas id="scannerCanvas" style="display:none"></canvas>

                <!-- Scan Frame Overlay -->
                <div class="scan-overlay">
                    <div class="scan-frame" id="scanFrame">
                        <div class="corner tl"></div>
                        <div class="corner tr"></div>
                        <div class="corner bl"></div>
                        <div class="corner br"></div>
                        <div class="scan-line" id="scanLine"></div>
                    </div>
                    <p class="scan-hint" id="scanHint">Apunta la cámara al código QR de la boleta</p>
                </div>

                <!-- Camera off state -->
                <div class="camera-off" id="cameraOff">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
                        <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
                        <circle cx="12" cy="13" r="4"/>
                    </svg>
                    <p>Cámara inactiva</p>
                    <button class="btn-activate" id="activateCamera">
                        ACTIVAR CÁMARA
                    </button>
                </div>
            </div>

        </div>

        <!-- Controls -->
        <div class="scanner-controls">
            <button class="ctrl-btn" id="btnToggleScan" onclick="toggleScanning()">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/>
                    <rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>
                </svg>
                <span>ESCANEAR</span>
            </button>

            <button class="ctrl-btn secondary" id="btnManual" onclick="openManualInput()">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="17" y1="10" x2="3" y2="10"/><line x1="21" y1="6" x2="3" y2="6"/>
                    <line x1="21" y1="14" x2="3" y2="14"/><line x1="17" y1="18" x2="3" y2="18"/>
                </svg>
                <span>MANUAL</span>
            </button>

            <button class="ctrl-btn secondary" id="btnFlash" onclick="toggleFlash()" style="display:none">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
                </svg>
                <span>FLASH</span>
            </button>
        </div>
    </div>

    <!-- Result Modal -->
    <div class="result-overlay" id="resultOverlay" style="display:none" onclick="closeResult()">
        <div class="result-card" id="resultCard" onclick="event.stopPropagation()">

            <!-- Result Icon -->
            <div class="result-icon-wrap" id="resultIconWrap">
                <div class="result-icon" id="resultIcon"></div>
            </div>

            <!-- Status -->
            <div class="result-status" id="resultStatus"></div>
            <div class="result-message" id="resultMessage"></div>

            <!-- Ticket Info (shown on valid) -->
            <div class="ticket-info" id="ticketInfo" style="display:none">
                <div class="ticket-row">
                    <span class="t-lbl">EVENTO</span>
                    <span class="t-val" id="t-event"></span>
                </div>
                <div class="ticket-row">
                    <span class="t-lbl">TITULAR</span>
                    <span class="t-val" id="t-holder"></span>
                </div>
                <div class="ticket-row">
                    <span class="t-lbl">ASIENTO</span>
                    <span class="t-val" id="t-seat"></span>
                </div>
                <div class="ticket-row">
                    <span class="t-lbl">ZONA</span>
                    <span class="t-val" id="t-zone"></span>
                </div>
                <div class="ticket-row">
                    <span class="t-lbl">TIPO</span>
                    <span class="t-val" id="t-type"></span>
                </div>
            </div>

            <button class="btn-close-result" onclick="closeResult()">
                CONTINUAR ESCANEO
            </button>
        </div>
    </div>

    <!-- Manual Input Modal -->
    <div class="manual-overlay" id="manualOverlay" style="display:none">
        <div class="manual-card">
            <h3>INGRESO MANUAL</h3>
            <p>Introduce el código de la boleta</p>
            <input type="text" id="manualInput" class="manual-input"
                   placeholder="Ej: TKT-2024-ABC123XYZ"
                   autocomplete="off" autocapitalize="characters" />
            <div class="manual-actions">
                <button class="btn-manual-cancel" onclick="closeManualInput()">CANCELAR</button>
                <button class="btn-manual-submit" onclick="submitManual()">VALIDAR</button>
            </div>
        </div>
    </div>

    <!-- Loading overlay -->
    <div class="loading-overlay" id="loadingOverlay" style="display:none">
        <div class="loading-spinner">
            <div class="spinner-ring"></div>
            <span>VALIDANDO...</span>
        </div>
    </div>

</div>

@section Scripts {
<script src="~/js/jsqr.min.js"></script>
<script src="~/js/scanner.js"></script>
}
